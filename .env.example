# X (Twitter) API Credentials - OAuth 1.0a
# Obtén estos tokens desde developer.x.com

# API Key y Secret (Consumer Key y Consumer Secret)
TWITTER_APP_KEY=tu_api_key_aqui
TWITTER_APP_SECRET=tu_api_secret_aqui

# Access Token y Secret
TWITTER_ACCESS_TOKEN=tu_access_token_aqui
TWITTER_ACCESS_SECRET=tu_access_token_secret_aqui

# Configuración opcional
LOG_LEVEL=info
LOG_TO_FILE=true
NODE_ENV=development
PORT=3000
